# ElevenLabs: create a restricted API key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Bedrock Stable Image Ultra. Prefer AWS_PROFILE with `aws login` or `aws sso login`.
BEDROCK_IMAGE_REGION=us-west-2
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-ultra-v1:1
AWS_PROFILE=default

# Optional private cloud library. Keep the bucket private; the Nuxt server is the only S3 client.
STATION_S3_BUCKET=
STATION_S3_REGION=us-west-2

# Optional: enables user-confirmed private Seedance animated loops through OpenRouter.
# This key stays server-side; generated source URLs and videos are never exposed directly.
OPENROUTER_API_KEY=

# Stream Deck control defaults to loopback-only. To use a VPN, bind only to the
# machine's VPN interface address (never 0.0.0.0) and set a long random token.
# The server refuses a non-loopback binding without NUXT_CONTROL_TOKEN.
STATION_BIND_HOST=127.0.0.1
NUXT_CONTROL_TOKEN=
